{
  "name": "vue3-template",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": "24.22.2",
    "npm": ">=10"
  },
  "scripts": {
    "start": "npm run dev",
    "dev": "vite --open",
    "stg": "vite --mode staging",
    "typecheck": "vue-tsc -b",
    "build:only:dev": "vite build --mode development",
    "build:only:stg": "vite build --mode staging",
    "build:only:prod": "vite build",
    "build": "vue-tsc -b && vite build",
    "lint": "eslint src e2e playwright.config.ts",
    "lint:fix": "eslint src e2e playwright.config.ts --fix",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:open": "playwright test --ui",
    "test:e2e:install": "playwright install chromium",
    "test:all": "npm run test && npm run test:e2e",
    "prepare": "husky"
  },
  "dependencies": {
    "material-symbols": "0.47.0",
    "ofetch": "1.5.1",
    "pinia": "4.0.2",
    "vue": "3.5.44",
    "vue-i18n": "11.4.16",
    "vue-router": "5.2.0",
    "vuetify": "4.1.8"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@intlify/eslint-plugin-vue-i18n": "4.5.1",
    "@playwright/test": "1.64.1",
    "@types/node": "24.13.3",
    "@vitejs/plugin-vue": "6.0.8",
    "@vitest/coverage-v8": "4.1.12",
    "@vue/server-renderer": "3.5.44",
    "@vue/test-utils": "2.4.11",
    "@vue/tsconfig": "0.9.1",
    "eslint": "10.8.1",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-prettier": "5.5.6",
    "eslint-plugin-vue": "10.10.0",
    "globals": "17.9.0",
    "happy-dom": "21.0.4",
    "husky": "9.1.7",
    "lint-staged": "17.4.1",
    "prettier": "3.9.6",
    "sass-embedded": "1.100.0",
    "typescript": "6.0.2",
    "typescript-eslint": "8.67.0",
    "vite": "8.2.4",
    "vite-plugin-vue-devtools": "8.2.1",
    "vite-plugin-vuetify": "2.1.3",
    "vitest": "4.1.12",
    "vue-tsc": "3.3.8"
  },
  "lint-staged": {
    "{src,e2e}/**/*.{js,mjs,ts,vue}": [
      "eslint --fix",
      "prettier --write"
    ],
    "**/*.{json,md,scss,css,yml,yaml}": [
      "prettier --write"
    ]
  },
  "allowScripts": {
    "@parcel/watcher@2.6.0": true
  }
}
