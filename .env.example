# ==========================================
# Configurações de Ambiente
# ==========================================
NODE_ENV=devlopment

# ==========================================
# Configurações Gerais da Aplicação
# ==========================================
VITE_APP_NAME='My App'
VITE_APP_DEFAULT_LOCALE='pt-BR'

# ==========================================
# Autenticação
# ==========================================

# Mock de autenticação (sem SegID real). Use 'true' enquanto o projeto não
# tiver um módulo configurado no SegID. Ao configurar o SegID, defina 'false' e
# preencha as variáveis VITE_SEGID_* abaixo — nenhuma mudança de código é necessária.
# Desligado quando ausente (fail-closed) e PROIBIDO no modo production: a
# aplicação não inicia com o mock ativo nesse modo (ADR-0017).
VITE_AUTH_MOCK=true

# ==========================================
# Endpoints de Conexão
# ==========================================

# SEGID - URL do Sistema de Segurança Corporativa
VITE_SEGID_BASE_URL=https://homologacao.ssc.prodemge.gov.br/ssc-idp-frontend/rest/oidc # ATENÇÃO: NÃO ALTERAR!
VITE_SEGID_CLIENT_ID=adicione_o_client_id_da_sua_aplicacao # CLient ID
VITE_SEGID_CONTEXT=codigo_aplicacao # ex: m1ee
VITE_SEGID_RESPONSE_TYPE=code # ATENÇÃO: NÃO ALTERAR!
VITE_SEGID_SCOPE=openid+unidade+roles+papeis+recursos_operacoes+profile+email+phone+modulo+outras_unidades+nivel_govbr+access_token_govbr # OBS: Alterar conforme necessidade

# API - URL de chamadas de requisições. Você pode adicionar base URL de integrações aqui
VITE_API_BASE_URL=base_url_do_backend # possui os endereços de auth-backend e apis de serviço

VITE_API_BACKEND=${VITE_API_BASE_URL}/extensao_backend # url das apis de serviço do backend. Ex: '/v1/api'
VITE_AUTH_BACKEND=${VITE_API_BASE_URL}/auth-backend # url do auth backend para autenticação via Seg.ID

# ==========================================
# BFF (cookie de sessão + CSRF) — RF-FE-03/06
# ==========================================
# Módulo da aplicação. Compõe o nome do cookie de CSRF (XSRF-TOKEN_<modulo>) e o
# header x-id-modulo. Se vazio, usa VITE_SEGID_CONTEXT.
# VITE_APP_MODULO=m1de
# Prefixo do cookie de CSRF (nome final: <prefixo>_<modulo>). Default: XSRF-TOKEN
# VITE_CSRF_COOKIE_PREFIX=XSRF-TOKEN
# Nome do header de CSRF reenviado nas requisições mutantes. Default: X-CSRF-Token
# VITE_CSRF_HEADER_NAME=X-CSRF-Token
