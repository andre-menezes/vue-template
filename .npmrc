# Garante que toda nova dependência adicionada via `npm install` será salva
# com versão exata (sem ^ ou ~). Equivalente a --save-exact por padrão.
save-exact=true
# Bloqueia a instalação quando a versão do Node/npm não atende ao campo
# `engines` do package.json (linha 24, a partir da 24.22.2). Sem isso, o npm apenas
# emitiria um aviso (EBADENGINE) em vez de falhar.
engine-strict=true
