# ==========================================
# Ambiente de testes (modo `test`: Vitest e E2E)
# ==========================================
# Valores fixos e fictícios, versionados para que a suíte rode igual na máquina
# do desenvolvedor e no CI, sem depender de `.env.development.local`.
# Não coloque URLs ou credenciais reais aqui.

VITE_APP_NAME='Vue 3 Template'
VITE_APP_DEFAULT_LOCALE='pt-BR'

# Os testes unitários exercitam o fluxo real; o mock é ligado pontualmente via
# vi.mock. No E2E, o playwright.config.ts liga o mock (VITE_AUTH_MOCK=true).
VITE_AUTH_MOCK=false

VITE_SEGID_BASE_URL=https://ssc.test.invalid
VITE_SEGID_CLIENT_ID=client-id-test
VITE_SEGID_CONTEXT=m1de
VITE_SEGID_RESPONSE_TYPE=code
VITE_SEGID_SCOPE=openid

VITE_API_BACKEND=https://api.test.invalid/api
VITE_AUTH_BACKEND=https://api.test.invalid/auth-backend
